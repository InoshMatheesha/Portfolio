---
// Base.astro - Document shell: metadata, fonts, global styles and scripts.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoUrl from '@fontsource-variable/martian-mono/files/martian-mono-latin-wdth-normal.woff2?url';
import { getImage } from 'astro:assets';
import avatar from '../../assets/profile-avatar.jpg';
import { person, contact, targetRoles } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Social card image; absolute only when the site URL is known.
const card = await getImage({ src: avatar, width: 1200, height: 1200, format: 'jpg' });
const cardUrl = Astro.site ? new URL(card.src, Astro.site).href : card.src;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  alternateName: person.handle,
  jobTitle: person.role,
  worksFor: { '@type': 'Organization', name: person.employer },
  alumniOf: { '@type': 'CollegeOrUniversity', name: person.university },
  address: { '@type': 'PostalAddress', addressCountry: 'LK' },
  email: `mailto:${contact.email}`,
  url: canonical,
  image: cardUrl,
  sameAs: [contact.github.href, contact.linkedin.href, contact.medium.href],
  knowsAbout: ['Cyber security', 'Penetration testing', 'Security operations', ...targetRoles],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta name="theme-color" content="#0a1018" />
    <meta name="color-scheme" content="dark" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={cardUrl} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
