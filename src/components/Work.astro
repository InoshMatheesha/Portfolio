---
// Work.astro - Every project on one moving chain, with filters and GitHub numbers.
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import { categories, projects } from '../data/projects';
import GithubPulse from './GithubPulse.astro';

const count = (id: string) => projects.filter((project) => project.category === id).length;
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="work__top">
      <header class="sec-head reveal">
        <p class="eyebrow">Work</p>
        <h2 id="work-title">Built, shipped and documented.</h2>
        <p class="lede">
          Every project rides one chain, security tooling first. It keeps moving on its own; hover
          to stop it, then drag or use the arrows to browse.
        </p>
      </header>

    </div>

    <div class="bar reveal">
      <div class="filters" role="group" aria-label="Filter projects">
        <button class="filter" type="button" data-filter="all" aria-pressed="true">
          All <span>{projects.length}</span>
        </button>
        {
          categories.map((category) => (
            <button class={`filter c-${category.id}`} type="button" data-filter={category.id} aria-pressed="false">
              <i aria-hidden="true" />
              {category.label} <span>{count(category.id)}</span>
            </button>
          ))
        }
      </div>

      <div class="controls">
        <span class="meter" data-belt-meter aria-hidden="true"></span>
        <button class="ctrl" type="button" data-belt-step="-1" aria-label="Previous project">
          <Icon name="left" />
        </button>
        <button class="ctrl ctrl--toggle" type="button" data-belt-toggle aria-pressed="false" aria-label="Pause the chain">
          <Icon name="pause" /><Icon name="play" />
        </button>
        <button class="ctrl" type="button" data-belt-step="1" aria-label="Next project">
          <Icon name="right" />
        </button>
      </div>
    </div>
  </div>

  <div class="belt reveal" data-belt>
    <div class="belt__view" data-belt-view tabindex="0" role="region" aria-label="All projects, horizontal list">
      <div class="belt__track" data-belt-track>
        {projects.map((project, index) => <ProjectCard project={project} eager={index < 4} />)}
      </div>
    </div>
  </div>

  <div class="wrap">
    <GithubPulse />
  </div>
</section>

<style>
  .work__top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .work__top .sec-head {
    margin-bottom: 0;
  }

  /* --- Filters ---------------------------------------------------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--rivet);
    border-radius: 0.6rem;
    color: var(--fog);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s,
      translate 0.2s var(--ease-out);
  }

  .filter i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--c);
  }

  .filter span {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 0.6875rem;
    opacity: 0.85;
  }

  .filter:hover {
    color: var(--bone);
    border-color: var(--rivet-2);
    translate: 0 -1px;
  }

  .filter:active {
    translate: 0 1px;
  }

  .filter[aria-pressed='true'] {
    border-color: var(--bone);
    background: var(--bone);
    color: var(--abyss);
  }

  .filter[aria-pressed='true'] i {
    outline: 1px solid color-mix(in oklab, var(--abyss) 50%, transparent);
  }

  /* --- Bar: filters left, chain controls right ---------------------- */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* How far round the loop the chain has travelled. */
  .meter {
    --p: 0;
    position: relative;
    width: clamp(4rem, 12vw, 9rem);
    height: 2px;
    margin-right: 0.6rem;
    border-radius: 2px;
    background: var(--rivet);
    overflow: hidden;
  }

  .meter::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--ember), var(--bone) 50%, var(--signal));
    transform-origin: left;
    transform: scaleX(var(--p));
  }

  .ctrl {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--rivet-2);
    border-radius: 0.7rem;
    background: var(--hull);
    color: var(--fog);
    box-shadow: 0 3px 0 #05090f;
    transition:
      color 0.2s,
      border-color 0.2s,
      transform 0.15s var(--ease-out),
      box-shadow 0.15s var(--ease-out);
  }

  .ctrl:hover {
    border-color: var(--fog);
    color: var(--bone);
    transform: translateY(-1px);
    box-shadow: 0 4px 0 #05090f;
  }

  .ctrl:active {
    transform: translateY(3px);
    box-shadow: 0 0 0 #05090f;
  }

  .ctrl :global(svg) {
    grid-area: 1 / 1;
  }

  /* The toggle shows pause while moving and play while stopped. */
  .ctrl--toggle :global(svg + svg),
  .ctrl--toggle[aria-pressed='true'] :global(svg:first-child) {
    display: none;
  }

  .ctrl--toggle[aria-pressed='true'] :global(svg + svg) {
    display: block;
  }

  /* --- The chain ---------------------------------------------------- */
  .belt {
    --card-w: clamp(17.5rem, 27vw, 22.5rem);
    --link-gap: 2.4rem;
    --edge: max(var(--gutter), calc((100vw - var(--wrap)) / 2));
    margin-top: 0.5rem;
  }

  .belt__view {
    padding: 1.75rem var(--edge) 3rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
    cursor: grab;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 calc(var(--edge) * 0.9),
      #000 calc(100% - var(--edge) * 0.9),
      transparent
    );
  }

  .belt__view::-webkit-scrollbar {
    display: none;
  }

  .belt__view:focus-visible {
    outline-offset: -4px;
  }

  .belt__track {
    display: flex;
    gap: var(--link-gap);
    width: max-content;
    margin-inline: auto;
  }

  :global(.belt.is-dragging) .belt__view {
    cursor: grabbing;
    user-select: none;
  }

  :global(.belt.is-dragging) .belt__track {
    pointer-events: none;
  }

  @media (max-width: 44rem) {
    .belt {
      --card-w: min(78vw, 20rem);
      --link-gap: 1.75rem;
    }

    .meter {
      display: none;
    }
  }
</style>
