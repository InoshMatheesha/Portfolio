---
// Work.astro - Project grid with category filters and GitHub numbers.
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import { categories, projects } from '../data/projects';
import { contact, github } from '../data/site';

const count = (id: string) => projects.filter((project) => project.category === id).length;
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="work__top">
      <header class="sec-head reveal">
        <p class="eyebrow">Work</p>
        <h2 id="work-title">Built, shipped and documented.</h2>
        <p class="lede">
          Security tooling first, then the software I build because shipping is the fastest way to
          learn how things break.
        </p>
      </header>

      <a class="gh reveal" href={contact.github.href} target="_blank" rel="noopener noreferrer">
        <span class="gh__head mono">
          GitHub <span class="sr-only">profile (opens in a new tab)</span>
          <Icon name="external" />
        </span>
        <dl class="gh__stats">
          {
            github.map((stat) => (
              <div>
                <dd>{stat.value}</dd>
                <dt class="mono">{stat.label}</dt>
              </div>
            ))
          }
        </dl>
      </a>
    </div>

    <div class="filters reveal" role="group" aria-label="Filter projects">
      <button class="filter" type="button" data-filter="all" aria-pressed="true">
        All <span>{projects.length}</span>
      </button>
      {
        categories.map((category) => (
          <button class={`filter c-${category.id}`} type="button" data-filter={category.id} aria-pressed="false">
            <i aria-hidden="true" />
            {category.label} <span>{count(category.id)}</span>
          </button>
        ))
      }
    </div>

    <div class="grid" data-grid>
      {projects.map((project, index) => <ProjectCard project={project} eager={index < 3} />)}
    </div>
  </div>
</section>

<style>
  .work__top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .work__top .sec-head {
    margin-bottom: 0;
  }

  /* --- GitHub numbers --------------------------------------------- */
  .gh {
    display: grid;
    gap: 0.9rem;
    padding: 1rem 1.15rem 1.1rem;
    border: 1px solid var(--rivet);
    border-radius: var(--radius);
    background: var(--hull);
    transition:
      border-color 0.3s,
      transform 0.4s var(--ease-out);
  }

  .gh:hover {
    border-color: var(--fog);
    transform: translateY(-3px);
  }

  .gh__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--fog);
  }

  .gh__head :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
  }

  .gh__stats {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 1.75rem;
  }

  .gh__stats div {
    display: grid;
    gap: 0.2rem;
  }

  .gh__stats dd {
    font-size: 1.7rem;
    font-weight: 760;
    font-stretch: 118%;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .gh__stats dt {
    color: var(--fog);
    font-size: 0.6rem;
  }

  /* --- Filters ---------------------------------------------------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--rivet);
    border-radius: 0.6rem;
    color: var(--fog);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s,
      translate 0.2s var(--ease-out);
  }

  .filter i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--c);
  }

  .filter span {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 0.6875rem;
    opacity: 0.85;
  }

  .filter:hover {
    color: var(--bone);
    border-color: var(--rivet-2);
    translate: 0 -1px;
  }

  .filter:active {
    translate: 0 1px;
  }

  .filter[aria-pressed='true'] {
    border-color: var(--bone);
    background: var(--bone);
    color: var(--abyss);
  }

  .filter[aria-pressed='true'] i {
    outline: 1px solid color-mix(in oklab, var(--abyss) 50%, transparent);
  }

  /* --- Grid ------------------------------------------------------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 68rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 44rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .gh {
      width: 100%;
    }

    .gh__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }
</style>
