---
// Hero.astro - Name, thesis and the interactive five-layer stack.
import Icon from './Icon.astro';
import StackArt from './StackArt.astro';
import { layers } from '../data/layers';
import { person } from '../data/site';

// Plates render bottom-up so later siblings sit higher in the stack.
const plates = [...layers].sort((a, b) => a.n - b.n);
---

<section class="hero" id="top" data-hero>
  <div class="wrap hero__grid">
    <div class="hero__intro">
      <p class="eyebrow hero__eyebrow">
        Cyber security undergraduate @ {person.universityShort}
        <span aria-hidden="true">/</span>
        {person.role} @ {person.employer}
      </p>
      <h1 class="name">
        <span class="name__line"><span>{person.firstName}</span></span>
        <span class="name__line"><span>{person.lastName}</span></span>
      </h1>
      <p class="thesis">
        From the <em class="thesis__usb">USB port</em> to the <em class="thesis__soc">SOC queue</em>.
      </p>
    </div>

    <div class="scene" aria-hidden="true">
      <div class="stack" data-stack>
        {
          plates.map((layer) => (
            <a class={`plate plate--${layer.n}`} href={layer.href} tabindex="-1" data-layer={layer.n}>
              <StackArt n={layer.n} />
              <span class="plate__ripple" />
              <span class="plate__label">
                L{layer.n} {layer.title}
              </span>
            </a>
          ))
        }
        <span class="via"><span class="via__pulse"></span></span>
        <span class="ground"></span>
      </div>
    </div>

    <ol class="layers" reversed aria-label="Layers I work at, from detection down to hardware">
      {
        layers.map((layer) => (
          <li>
            <a class={`row row--${layer.n}`} href={layer.href} data-layer={layer.n}>
              <span class="row__tag mono">L{layer.n}</span>
              <span class="row__title">{layer.title}</span>
              <span class="row__detail">{layer.detail}</span>
              <span class="row__arrow">
                <Icon name="arrow" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="hero__cta">
      <a class="btn" href="#work" data-magnet>
        See the work
        <span class="btn__icon"><Icon name="arrow" /><Icon name="arrow" /></span>
      </a>
      <a class="btn btn--ghost" href="#contact" data-magnet>Get in touch</a>
      <p class="status mono">
        <span class="status__dot" aria-hidden="true"></span>
        {person.status}
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    overflow-x: clip;
    padding-top: calc(var(--nav-h) + clamp(1.25rem, 4vh, 3rem));
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    grid-template-areas:
      'intro scene'
      'layers scene'
      'cta scene';
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: clamp(1.25rem, 3.2vh, 2.25rem);
    align-items: center;
  }

  .hero__intro {
    grid-area: intro;
  }

  /* --- Intro type ----------------------------------------------- */
  .hero__eyebrow {
    flex-wrap: wrap;
    row-gap: 0.2rem;
    animation: rise 0.9s var(--ease-out) 0.05s backwards;
  }

  .hero__eyebrow span {
    color: var(--rivet-2);
  }

  .name {
    margin-top: clamp(0.9rem, 2.4vh, 1.5rem);
    margin-left: -0.035em;
    font-size: clamp(2.9rem, 6.3vw, 5.9rem);
    font-weight: 820;
    font-stretch: 125%;
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  /* Each line is a mask the word rises out of. */
  .name__line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    padding-bottom: 0.06em;
  }

  .name__line span {
    display: block;
    animation: unmask 1.1s var(--ease-out) backwards;
  }

  .name__line:nth-child(1) span {
    animation-delay: 0.12s;
  }

  .name__line:nth-child(2) span {
    animation-delay: 0.22s;
  }

  .thesis {
    margin-top: clamp(0.9rem, 2.2vh, 1.4rem);
    font-size: clamp(1.25rem, 2.1vw, 1.85rem);
    font-weight: 420;
    font-stretch: 100%;
    line-height: 1.2;
    letter-spacing: -0.01em;
    animation: rise 0.9s var(--ease-out) 0.42s backwards;
  }

  .thesis em {
    font-style: normal;
    font-weight: 640;
    white-space: nowrap;
  }

  .thesis__usb {
    color: var(--ember);
  }

  .thesis__soc {
    color: var(--signal);
  }

  /* --- Layer index ---------------------------------------------- */
  .layers {
    grid-area: layers;
    border-top: 1px solid var(--rivet);
  }

  .layers li {
    animation: rise 0.8s var(--ease-out) backwards;
  }

  .layers li:nth-child(1) { animation-delay: 0.55s; }
  .layers li:nth-child(2) { animation-delay: 0.61s; }
  .layers li:nth-child(3) { animation-delay: 0.67s; }
  .layers li:nth-child(4) { animation-delay: 0.73s; }
  .layers li:nth-child(5) { animation-delay: 0.79s; }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 2.1rem minmax(8.5rem, 0.5fr) minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.85rem;
    padding: 0.72rem 0.6rem 0.72rem 0.75rem;
    border-bottom: 1px solid var(--rivet);
    transition: background 0.3s;
  }

  /* Layer colour runs down the leading edge of the active row. */
  .row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--c);
    scale: 1 0;
    transition: scale 0.35s var(--ease-out);
  }

  .row--1,
  .plate--1 { --c: var(--l1); }
  .row--2,
  .plate--2 { --c: var(--l2); }
  .row--3,
  .plate--3 { --c: var(--l3); }
  .row--4,
  .plate--4 { --c: var(--l4); }
  .row--5,
  .plate--5 { --c: var(--l5); }

  .row__tag {
    color: var(--c);
  }

  .row__title {
    font-weight: 660;
    font-stretch: 108%;
    font-size: 0.98rem;
    line-height: 1.25;
  }

  .row__detail {
    color: var(--fog);
    font-size: 0.86rem;
    line-height: 1.35;
    transition: color 0.3s;
  }

  .row__arrow {
    color: var(--c);
    opacity: 0;
    translate: -0.5rem 0;
    transition:
      opacity 0.3s,
      translate 0.35s var(--ease-out);
  }

  .row:hover,
  .row:focus-visible,
  .row.is-active {
    background: color-mix(in oklab, var(--c) 7%, transparent);
  }

  .row:hover::before,
  .row:focus-visible::before,
  .row.is-active::before {
    scale: 1 1;
  }

  .row:hover .row__detail,
  .row:focus-visible .row__detail,
  .row.is-active .row__detail {
    color: var(--bone);
  }

  .row:hover .row__arrow,
  .row:focus-visible .row__arrow,
  .row.is-active .row__arrow {
    opacity: 1;
    translate: 0 0;
  }

  /* --- Calls to action ------------------------------------------ */
  .hero__cta {
    grid-area: cta;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.1rem;
    padding-top: 0.35rem;
    animation: rise 0.9s var(--ease-out) 0.9s backwards;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: 0.4rem;
    color: var(--fog);
  }

  .status__dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
  }

  .status__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--signal);
    animation: ping 2.4s var(--ease-out) infinite;
  }

  /* --- The stack ------------------------------------------------- */
  .scene {
    --plate: clamp(13rem, 25.5vw, 21.5rem);
    --gap: calc(var(--plate) * 0.215);
    grid-area: scene;
    display: grid;
    place-items: center;
    height: calc(var(--plate) * 1.78);
    perspective: 1800px;
  }

  .stack {
    --rx: 0deg;
    --rz: 0deg;
    position: relative;
    width: var(--plate);
    height: var(--plate);
    transform-style: preserve-3d;
    transform: translateY(calc(var(--gap) * 1.7)) rotateX(calc(57deg + var(--rx))) rotateZ(calc(-45deg + var(--rz)));
    animation: float 9s ease-in-out infinite alternate;
  }

  .plate {
    --lift: 0px;
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in oklab, var(--c) 62%, transparent);
    border-radius: 6%;
    color: var(--c);
    background:
      linear-gradient(135deg, color-mix(in oklab, var(--c) 10%, transparent), transparent 55%),
      color-mix(in oklab, var(--hull) 88%, transparent);
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--i) * var(--gap) + var(--lift)));
    transition:
      transform 0.75s var(--ease-out),
      opacity 0.45s,
      border-color 0.3s,
      box-shadow 0.4s;
    animation: drop 1.15s var(--ease-out) backwards;
    animation-delay: calc(0.3s + var(--i) * 0.12s);
  }

  .plate--1 { --i: 0; }
  .plate--2 { --i: 1; }
  .plate--3 { --i: 2; }
  .plate--4 { --i: 3; }
  .plate--5 { --i: 4; }

  /* A second face just below gives the plate thickness. */
  .plate::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid color-mix(in oklab, var(--c) 34%, transparent);
    border-radius: inherit;
    background: color-mix(in oklab, var(--c) 12%, var(--abyss));
    transform: translateZ(calc(var(--plate) * -0.024));
    pointer-events: none;
  }

  .plate__label {
    position: absolute;
    left: 19%;
    bottom: 7.2%;
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: clamp(0.5rem, 0.78vw, 0.66rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* A ring expands from the via as the signal passes this layer. */
  .plate__ripple {
    position: absolute;
    left: 11.875%;
    bottom: 11.875%;
    width: 4.4%;
    aspect-ratio: 1;
    margin: 0 0 -2.2% -2.2%;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0;
    animation: ripple 6s linear infinite;
    animation-delay: calc(2.3s + var(--i) * 0.5s);
  }

  /* Idle animation stops while the hero is off screen. */
  .hero.is-away .stack,
  .hero.is-away .via__pulse,
  .hero.is-away .plate__ripple,
  .hero.is-away .status__dot::after {
    animation-play-state: paused;
  }

  .plate.is-active {
    border-color: var(--c);
    box-shadow:
      0 0 0 1px var(--c),
      0 0 3.5rem -0.5rem color-mix(in oklab, var(--c) 55%, transparent);
  }

  /* Plates above the active one rise and fade to expose it. */
  .plate.is-lifted {
    --lift: calc(var(--gap) * 1.35);
    opacity: 0.14;
    pointer-events: none;
  }

  /* Soft light pooled under the stack anchors it in space. */
  .ground {
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--ember) 26%, transparent), transparent);
    transform: translateZ(calc(var(--gap) * -1.1));
    pointer-events: none;
    animation: rise 1.4s var(--ease-out) 0.3s backwards;
  }

  /* Vertical trace joining the vias of every plate. */
  .via {
    position: absolute;
    left: 11.875%;
    bottom: 11.875%;
    width: 2px;
    height: calc(var(--gap) * 4);
    margin-left: -1px;
    background: linear-gradient(to top, var(--l1), var(--l3), var(--l5));
    opacity: 0.55;
    transform-origin: 50% 100%;
    transform: rotateX(-90deg) rotateY(-45deg);
    transform-style: preserve-3d;
    pointer-events: none;
    animation: rise 1s var(--ease-out) 1.4s backwards;
  }

  .via__pulse {
    position: absolute;
    left: -2px;
    bottom: 0;
    width: 6px;
    height: 1.5rem;
    border-radius: 3px;
    background: linear-gradient(to top, transparent, #fff);
    box-shadow: 0 0 14px 3px rgb(255 255 255 / 0.55);
    opacity: 0;
    animation: travel 6s linear 2s infinite;
  }

  /* --- Keyframes -------------------------------------------------- */
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 1.1rem;
    }
  }

  @keyframes unmask {
    from {
      translate: 0 108%;
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      translate: 0 0 22rem;
    }
  }

  @keyframes float {
    from {
      translate: 0 -0.4rem;
    }
    to {
      translate: 0 0.4rem;
    }
  }

  @keyframes ping {
    from {
      opacity: 0.7;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 3.4;
    }
  }

  @keyframes ripple {
    0% {
      opacity: 1;
      scale: 1;
    }
    16%,
    100% {
      opacity: 0;
      scale: 4.5;
    }
  }

  @keyframes travel {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    5% {
      opacity: 1;
      translate: 0 0;
    }
    38% {
      opacity: 1;
      translate: 0 calc(var(--gap) * -4);
    }
    44%,
    100% {
      opacity: 0;
      translate: 0 calc(var(--gap) * -4);
    }
  }

  /* --- Small screens: text, then stack, then the index ------------ */
  @media (max-width: 60rem) {
    .hero {
      min-height: 0;
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'intro'
        'scene'
        'layers'
        'cta';
    }

    .name {
      font-size: clamp(2.5rem, 12.6vw, 5rem);
    }

    .scene {
      --plate: clamp(11.5rem, 50vw, 19rem);
    }

    .row {
      grid-template-columns: 2rem minmax(0, 1fr) 1rem;
      grid-template-areas:
        'tag title arrow'
        '. detail detail';
      row-gap: 0.15rem;
    }

    .row__tag { grid-area: tag; }
    .row__title { grid-area: title; }
    .row__detail { grid-area: detail; }
    .row__arrow { grid-area: arrow; opacity: 1; translate: 0 0; }
  }

  @media (max-width: 30rem) {
    .hero__cta .btn {
      flex: 1 1 auto;
    }

    .status {
      flex-basis: 100%;
      margin-left: 0;
    }
  }
</style>
