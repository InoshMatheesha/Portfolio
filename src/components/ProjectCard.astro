---
// ProjectCard.astro - One project as a tilting card with layered depth.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
---

<article
  class={`card c-${project.category} reveal`}
  id={`project-${project.id}`}
  data-category={project.category}
  data-tilt
  data-tilt-max="5"
>
  <div class="card__inner" data-tilt-target>
    <div class="card__media">
      <Picture
        src={project.image}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[420, 640, 880]}
        sizes="(max-width: 44rem) 92vw, (max-width: 68rem) 46vw, 25rem"
        alt={`${project.name} logo`}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span class="card__type mono">{project.type}</span>
    </div>

    <div class="card__body">
      <h3>
        {project.name}
        {project.subtitle && <span>{project.subtitle}</span>}
      </h3>
      <p>{project.description}</p>
      <ul class="card__tech" aria-label="Built with">
        {project.tech.map((item) => <li class="chip">{item}</li>)}
      </ul>
      <div class="card__links">
        {
          project.links.map((link) => (
            <a class="link" href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span class="sr-only"> for {project.name} (opens in a new tab)</span>
              <Icon name="external" />
            </a>
          ))
        }
      </div>
    </div>

    <span class="card__glare" aria-hidden="true"></span>
  </div>
</article>

<style>
  .card {
    perspective: 1200px;
  }

  .card__inner {
    --gx: 50%;
    --gy: 0%;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--rivet);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--hull-2), var(--hull));
    transform-style: preserve-3d;
    transition:
      transform 0.6s var(--ease-out),
      border-color 0.3s,
      box-shadow 0.4s;
  }

  .card:hover .card__inner,
  .card:focus-within .card__inner,
  .card:target .card__inner {
    border-color: color-mix(in oklab, var(--c) 55%, var(--rivet));
    box-shadow: 0 2.2rem 3.5rem -2rem color-mix(in oklab, var(--c) 30%, #000);
  }

  /* --- Media ------------------------------------------------------ */
  .card__media {
    position: relative;
    margin: 0.6rem 0.6rem 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.6rem;
    background: #000;
    transform: translateZ(26px);
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06) brightness(0.86);
    transition:
      scale 0.9s var(--ease-out),
      filter 0.5s;
  }

  /* Duotone wash in the category colour, lifted on hover. */
  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, transparent 20%, var(--c));
    mix-blend-mode: color;
    opacity: 0.55;
    transition: opacity 0.5s;
  }

  .card:hover .card__media :global(img) {
    scale: 1.045;
    filter: grayscale(1) contrast(1.06) brightness(1);
  }

  .card:hover .card__media::after {
    opacity: 0.18;
  }

  .card__type {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    z-index: 1;
    padding: 0.3rem 0.55rem;
    border-radius: 0.35rem;
    background: color-mix(in oklab, var(--abyss) 78%, transparent);
    color: var(--c);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* --- Body ------------------------------------------------------- */
  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.15rem 1.25rem 1.25rem;
    transform: translateZ(14px);
  }

  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.6rem;
    font-size: 1.3rem;
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.15;
    letter-spacing: -0.012em;
  }

  h3 span {
    color: var(--fog);
    font-size: 0.9rem;
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0;
  }

  .card__body p {
    color: var(--fog);
    font-size: 0.95rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rivet);
  }

  /* Specular highlight that tracks the pointer. */
  .card__glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      22rem circle at var(--gx) var(--gy),
      color-mix(in oklab, var(--c) 15%, transparent),
      transparent 62%
    );
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }

  .card:hover .card__glare {
    opacity: 1;
  }
</style>
