---
// Footer.astro - Ethical notice, copyright and build version.
import pkg from '../../package.json';
import { ethics, person } from '../data/site';
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div class="notice">
      <p class="mono notice__title">Ethical security notice</p>
      <p>{ethics}</p>
    </div>
    <div class="footer__meta mono">
      <p>
        &copy; 2026 {person.name}. {person.title}.
      </p>
      <p>All research conducted ethically in authorized environments.</p>
      <p class="footer__build">
        v{pkg.version} / Static site, no trackers, no third-party scripts /
        <a href="/.well-known/security.txt">security.txt</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 3rem 3.5rem;
    border-top: 1px solid var(--rivet);
    background: color-mix(in oklab, var(--abyss) 70%, transparent);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 4rem;
  }

  .notice {
    max-width: 34rem;
    padding-left: 1rem;
    border-left: 2px solid var(--ember);
    color: var(--fog);
    font-size: 0.92rem;
  }

  .notice__title {
    margin-bottom: 0.5rem;
    color: var(--bone);
  }

  .footer__meta {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    justify-items: end;
    color: var(--fog);
    text-align: right;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .footer__build {
    color: var(--fog);
  }

  .footer__build a {
    color: var(--fog);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__build a:hover {
    color: var(--bone);
  }

  @media (max-width: 52rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer__meta {
      justify-items: start;
      text-align: left;
    }
  }
</style>
